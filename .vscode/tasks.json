{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gcc-build",
            "type": "shell",
            "command": "${workspaceFolder}/gcc_build.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "jlink-flash",
            "type": "shell",
            "command": "${workspaceFolder}/jlink_flash.bat",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
